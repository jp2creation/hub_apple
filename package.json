{
  "name": "hub-apple",
  "private": true,
  "version": "1.0.38",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cap:sync": "capacitor sync ios",
    "cap:sync:ios": "capacitor sync ios",
    "cap:open:ios": "capacitor open ios",
    "ios:prepare": "npm run build && capacitor sync ios",
    "ios:open": "npm run ios:prepare && capacitor open ios",
    "mac:build": "bash scripts/build-mac-app.sh",
    "mac:pkg": "bash scripts/build-mac-pkg.sh"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/status-bar": "^8.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.4"
  }
}
