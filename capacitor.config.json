{
  "appId": "fr.jp2creation.hubapple",
  "appName": "JP2 Création",
  "webDir": "dist",
  "server": {
    "allowNavigation": [
      "*"
    ]
  },
  "ios": {
    "backgroundColor": "#f5f7fb",
    "contentInset": "automatic"
  },
  "plugins": {
    "App": {
      "disableBackButtonHandler": true
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true,
      "style": "LIGHT"
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#95002e"
    }
  }
}
